  "extensions": [
   ".cube"
  ],
  "format": "cube",
  "hashed": "sha256, recorded in provenance",
  "max_bytes": 209715200,
  "note": "a LUT is data read by ffmpeg's lut3d filter, never a filter string or executable; path policy applies (allowed_lut_roots)",
  "strength_range": [
   0.0,
   1.0
  ]
 },
 "provenance": {
  "identity": "sha256 over canonical JSON of {type, parameters, input identity, tool versions}; a LUT_APPLY identity uses the LUT's sha256, not its path; the source's identity is its file sha256; no timestamps, no UUIDs",
