   "operation_id",
   "type",
   "tool",
   "tool_versions",
   "parameters",
   "input_hash",
   "output_hash",
   "status",
   "measurements",
   "tool_commands_observed",
   "lut (LUT_APPLY only)"
  ],
  "per_output": [
